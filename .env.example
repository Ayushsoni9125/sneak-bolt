# ==============================================================================
# SneakerDrop Environment Template
# Duplicate this file as .env or .env.local and populate the secrets below
# ==============================================================================

# Supabase API Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Cryptographically Secure JWT Secret (Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=your-random-jwt-secret-at-least-32-chars

# Authentication & Session Secrets (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=your-random-auth-secret
ENCRYPTION_KEY=your-random-encryption-key

# Application Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
